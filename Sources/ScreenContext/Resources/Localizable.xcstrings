        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể thêm rãnh âm thanh vào bản ghi cục bộ."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将音频轨道添加到本地录制。"
          }
        },
