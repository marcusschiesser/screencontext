    "This permanently deletes the video and its keyframes.": {
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "يؤدي هذا إلى حذف الفيديو وإطاراته الرئيسية نهائيًا." } },
        "de": { "stringUnit": { "state": "translated", "value": "Dadurch werden das Video und seine Keyframes dauerhaft gelöscht." } },
        "en": { "stringUnit": { "state": "translated", "value": "This permanently deletes the video and its keyframes." } },
        "es": { "stringUnit": { "state": "translated", "value": "Esto elimina permanentemente el vídeo y sus fotogramas clave." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Cette action supprime définitivement la vidéo et ses images clés." } },
        "it": { "stringUnit": { "state": "translated", "value": "Questa operazione elimina definitivamente il video e i relativi fotogrammi chiave." } },
        "ja-JP": { "stringUnit": { "state": "translated", "value": "ビデオとキーフレームが完全に削除されます。" } },
        "ko-KR": { "stringUnit": { "state": "translated", "value": "비디오와 키프레임이 영구적으로 삭제됩니다." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Isso exclui permanentemente o vídeo e seus quadros-chave." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Видео и его ключевые кадры будут удалены без возможности восстановления." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Bu işlem videoyu ve anahtar karelerini kalıcı olarak siler." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Thao tác này sẽ xóa vĩnh viễn video và các khung hình chính." } },
        "zh-CN": { "stringUnit": { "state": "translated", "value": "这将永久删除视频及其关键帧。" } },
        "zh-TW": { "stringUnit": { "state": "translated", "value": "這將永久刪除影片及其關鍵影格。" } }
      }
    },
    "Allow Screen Recording for ScreenContext, then reopen or refresh sources.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بتسجيل الشاشة لـ ScreenContext، ثم أعد فتح المصادر أو تحديثها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirmaufnahme für ScreenContext erlauben und Quellen anschließend erneut öffnen oder aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Screen Recording for ScreenContext, then reopen or refresh sources."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite la grabación de pantalla para ScreenContext y vuelve a abrir o actualizar las fuentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser l’enregistrement de l’écran pour ScreenContext, puis rouvrir ou actualiser les sources."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti la registrazione schermo per ScreenContext, quindi riapri o aggiorna le sorgenti."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenContextの画面収録を許可してから、ソースを再度開くか更新してください。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenContext의 화면 기록을 허용한 다음 소스를 다시 열거나 새로 고치십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita a gravação da tela para o ScreenContext e reabra ou atualize as fontes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите ScreenContext запись экрана, затем снова откройте или обновите источники."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenContext için ekran kaydına izin verin, ardından kaynakları yeniden açın veya yenileyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép ScreenContext ghi màn hình, sau đó mở lại hoặc làm mới nguồn."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 ScreenContext 录制屏幕，然后重新打开或刷新来源。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 ScreenContext 錄製螢幕，然後重新開啟或重新整理來源。"
          }
        }
      }
    },
