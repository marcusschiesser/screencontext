    "No screen or window is available. Check Screen Recording permission and refresh sources.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد شاشة أو نافذة متاحة. تحقق من إذن تسجيل الشاشة وحدّث المصادر."
          }
        },
        "de": {
