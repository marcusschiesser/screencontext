    "Recording stopped because the Mac went to sleep.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف التسجيل لأن Mac دخل في وضع السكون."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme wurde beendet, weil der Mac in den Ruhezustand gewechselt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording stopped because the Mac went to sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación se detuvo porque el Mac entró en reposo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement s’est arrêté car le Mac s’est mis en veille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione è stata interrotta perché il Mac è entrato in stop."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "Macがスリープしたため収録を停止しました。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 잠자기 상태가 되어 녹화를 중지했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação parou porque o Mac entrou em repouso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись остановлена, потому что Mac перешёл в режим сна."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac uyku moduna geçtiği için kayıt durdu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã dừng ghi vì máy Mac chuyển sang chế độ ngủ."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
