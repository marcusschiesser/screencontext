    "Press ⇧⌘O to start recording. Press it again to stop.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "اضغط ⇧⌘O لبدء التسجيل. اضغط مرة أخرى لإيقافه."}},
        "de": {"stringUnit": {"state": "translated", "value": "Drücke ⇧⌘O, um die Aufnahme zu starten. Drücke erneut, um sie zu stoppen."}},
        "en": {"stringUnit": {"state": "translated", "value": "Press ⇧⌘O to start recording. Press it again to stop."}},
        "es": {"stringUnit": {"state": "translated", "value": "Pulsa ⇧⌘O para iniciar la grabación. Vuelve a pulsarlo para detenerla."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Appuyez sur ⇧⌘O pour démarrer l’enregistrement, puis à nouveau pour l’arrêter."}},
        "it": {"stringUnit": {"state": "translated", "value": "Premi ⇧⌘O per avviare la registrazione. Premi di nuovo per interromperla."}},
        "ja-JP": {"stringUnit": {"state": "translated", "value": "⇧⌘Oで録画を開始します。もう一度押すと停止します。"}},
        "ko-KR": {"stringUnit": {"state": "translated", "value": "⇧⌘O를 눌러 녹화를 시작하세요. 다시 누르면 중지됩니다."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Pressione ⇧⌘O para iniciar a gravação. Pressione novamente para parar."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Нажмите ⇧⌘O, чтобы начать запись. Нажмите ещё раз, чтобы остановить."}},
        "tr": {"stringUnit": {"state": "translated", "value": "Kaydı başlatmak için ⇧⌘O tuşlarına basın. Durdurmak için tekrar basın."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Nhấn ⇧⌘O để bắt đầu ghi. Nhấn lại để dừng."}},
        "zh-CN": {"stringUnit": {"state": "translated", "value": "按 ⇧⌘O 开始录制，再按一次停止。"}},
        "zh-TW": {"stringUnit": {"state": "translated", "value": "按 ⇧⌘O 開始錄製，再按一次停止。"}}
      }
    },
