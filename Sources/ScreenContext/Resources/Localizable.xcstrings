    },
    "Microphone disconnected. The recording is continuing without it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم فصل الميكروفون. يستمر التسجيل بدونه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon wurde getrennt. Die Aufnahme wird ohne es fortgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone disconnected. The recording is continuing without it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono se desconectó. La grabación continúa sin él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le microphone a été déconnecté. L’enregistrement continue sans lui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono è stato disconnesso. La registrazione continua senza di esso."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクが接続解除されました。マイクなしで収録を続けます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 연결이 해제되었습니다. 마이크 없이 녹화를 계속합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone foi desconectado. A gravação continuará sem ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон отключён. Запись продолжается без него."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon bağlantısı kesildi. Kayıt onsuz devam ediyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Micrô đã bị ngắt kết nối. Bản ghi vẫn tiếp tục mà không có micrô."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风已断开连接。录制将在没有麦克风的情况下继续。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風已中斷連線。錄製將在沒有麥克風的情況下繼續。"
          }
        }
      }
    },
    "Microphone permission is unavailable. Enable it in Privacy & Security before recording.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذن الميكروفون غير متاح. فعّله في الخصوصية والأمان قبل التسجيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mikrofonberechtigung ist nicht verfügbar. Vor der Aufnahme unter „Datenschutz & Sicherheit“ aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone permission is unavailable. Enable it in Privacy & Security before recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso del micrófono no está disponible. Actívalo en Privacidad y seguridad antes de grabar."
