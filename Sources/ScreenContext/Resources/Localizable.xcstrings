        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão do microfone não está disponível. Ative-a em Privacidade e Segurança antes de gravar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение на микрофон недоступно. Включите его в разделе «Конфиденциальность и безопасность» перед записью."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon izni kullanılamıyor. Kaydetmeden önce Gizlilik ve Güvenlik'te etkinleştirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
