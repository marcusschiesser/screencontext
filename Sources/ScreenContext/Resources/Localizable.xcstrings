    },
    "Claude supports contexts up to 14,000 characters. Shorten this context and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "يدعم Claude سياقات يصل طولها إلى 14,000 حرف. اختصر هذا السياق وحاول مرة أخرى." } },
        "de": { "stringUnit": { "state": "translated", "value": "Claude unterstützt Kontexte mit bis zu 14.000 Zeichen. Kürze diesen Kontext und versuche es erneut." } },
        "en": { "stringUnit": { "state": "translated", "value": "Claude supports contexts up to 14,000 characters. Shorten this context and try again." } },
        "es": { "stringUnit": { "state": "translated", "value": "Claude admite contextos de hasta 14.000 caracteres. Acorta este contexto e inténtalo de nuevo." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Claude accepte les contextes jusqu’à 14 000 caractères. Raccourcissez ce contexte et réessayez." } },
        "it": { "stringUnit": { "state": "translated", "value": "Claude supporta contesti fino a 14.000 caratteri. Riduci questo contesto e riprova." } },
        "ja-JP": { "stringUnit": { "state": "translated", "value": "Claude が対応するコンテキストは最大14,000文字です。コンテキストを短くして、もう一度お試しください。" } },
        "ko-KR": { "stringUnit": { "state": "translated", "value": "Claude는 최대 14,000자의 컨텍스트를 지원합니다. 컨텍스트를 줄인 후 다시 시도하십시오." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "O Claude aceita contextos de até 14.000 caracteres. Reduza este contexto e tente novamente." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Claude поддерживает контекст длиной до 14 000 символов. Сократите контекст и повторите попытку." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Claude en fazla 14.000 karakterlik bağlamları destekler. Bu bağlamı kısaltıp yeniden deneyin." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Claude hỗ trợ ngữ cảnh tối đa 14.000 ký tự. Hãy rút gọn ngữ cảnh này rồi thử lại." } },
        "zh-CN": { "stringUnit": { "state": "translated", "value": "Claude 支持最多 14,000 个字符的上下文。请缩短此上下文后重试。" } },
        "zh-TW": { "stringUnit": { "state": "translated", "value": "Claude 支援最多 14,000 個字元的內容脈絡。請縮短內容脈絡後再試一次。" } }
      }
    },
