    "Show in Finder": {
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "إظهار في Finder" } },
        "de": { "stringUnit": { "state": "translated", "value": "Im Finder zeigen" } },
        "en": { "stringUnit": { "state": "translated", "value": "Show in Finder" } },
        "es": { "stringUnit": { "state": "translated", "value": "Mostrar en el Finder" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Afficher dans le Finder" } },
        "it": { "stringUnit": { "state": "translated", "value": "Mostra nel Finder" } },
        "ja-JP": { "stringUnit": { "state": "translated", "value": "Finderに表示" } },
        "ko-KR": { "stringUnit": { "state": "translated", "value": "Finder에서 보기" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Mostrar no Finder" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Показать в Finder" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Finder’da Göster" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Hiển thị trong Finder" } },
        "zh-CN": { "stringUnit": { "state": "translated", "value": "在访达中显示" } },
        "zh-TW": { "stringUnit": { "state": "translated", "value": "在 Finder 中顯示" } }
      }
    },
    "ScreenContext preserved the partial recording. Show it in Finder to see whether it can be played.": {
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "احتفظ ScreenContext بالتسجيل الجزئي. اعرضه في Finder للتحقق مما إذا كان قابلاً للتشغيل." } },
        "de": { "stringUnit": { "state": "translated", "value": "ScreenContext hat die Teilaufnahme erhalten. Zeige sie im Finder, um zu prüfen, ob sie abgespielt werden kann." } },
        "en": { "stringUnit": { "state": "translated", "value": "ScreenContext preserved the partial recording. Show it in Finder to see whether it can be played." } },
        "es": { "stringUnit": { "state": "translated", "value": "ScreenContext conservó la grabación parcial. Muéstrala en el Finder para comprobar si se puede reproducir." } },
        "fr": { "stringUnit": { "state": "translated", "value": "ScreenContext a conservé l’enregistrement partiel. Affichez-le dans le Finder pour vérifier s’il peut être lu." } },
        "it": { "stringUnit": { "state": "translated", "value": "ScreenContext ha conservato la registrazione parziale. Mostrala nel Finder per verificare se può essere riprodotta." } },
        "ja-JP": { "stringUnit": { "state": "translated", "value": "ScreenContextは録画の一部を保持しました。再生できるか確認するにはFinderに表示してください。" } },
        "ko-KR": { "stringUnit": { "state": "translated", "value": "ScreenContext가 부분 녹화를 보존했습니다. 재생할 수 있는지 확인하려면 Finder에서 보십시오." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "O ScreenContext preservou a gravação parcial. Mostre-a no Finder para verificar se ela pode ser reproduzida." } },
        "ru": { "stringUnit": { "state": "translated", "value": "ScreenContext сохранил частичную запись. Откройте её в Finder, чтобы проверить воспроизведение." } },
        "tr": { "stringUnit": { "state": "translated", "value": "ScreenContext kısmi kaydı korudu. Oynatılıp oynatılamadığını görmek için Finder’da gösterin." } },
        "vi": { "stringUnit": { "state": "translated", "value": "ScreenContext đã giữ lại bản ghi một phần. Hiển thị bản ghi trong Finder để xem có thể phát hay không." } },
        "zh-CN": { "stringUnit": { "state": "translated", "value": "ScreenContext 已保留部分录制内容。请在访达中显示，以检查它能否播放。" } },
        "zh-TW": { "stringUnit": { "state": "translated", "value": "ScreenContext 已保留部分錄製內容。請在 Finder 中顯示，以檢查它能否播放。" } }
      }
    },
    "No usable recording was produced. Check your recording settings and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "لم يتم إنشاء تسجيل قابل للاستخدام. تحقق من إعدادات التسجيل وحاول مرة أخرى." } },
        "de": { "stringUnit": { "state": "translated", "value": "Es wurde keine verwendbare Aufnahme erstellt. Prüfe die Aufnahmeeinstellungen und versuche es erneut." } },
        "en": { "stringUnit": { "state": "translated", "value": "No usable recording was produced. Check your recording settings and try again." } },
        "es": { "stringUnit": { "state": "translated", "value": "No se produjo una grabación utilizable. Comprueba los ajustes de grabación e inténtalo de nuevo." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Aucun enregistrement utilisable n’a été produit. Vérifiez les réglages d’enregistrement et réessayez." } },
        "it": { "stringUnit": { "state": "translated", "value": "Non è stata prodotta una registrazione utilizzabile. Controlla le impostazioni di registrazione e riprova." } },
        "ja-JP": { "stringUnit": { "state": "translated", "value": "使用できる録画を作成できませんでした。録画設定を確認して、もう一度お試しください。" } },
        "ko-KR": { "stringUnit": { "state": "translated", "value": "사용 가능한 녹화가 생성되지 않았습니다. 녹화 설정을 확인하고 다시 시도하십시오." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Nenhuma gravação utilizável foi produzida. Verifique os ajustes de gravação e tente novamente." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Не удалось создать пригодную запись. Проверьте настройки записи и повторите попытку." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Kullanılabilir bir kayıt oluşturulamadı. Kayıt ayarlarını denetleyip yeniden deneyin." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Không tạo được bản ghi có thể sử dụng. Hãy kiểm tra cài đặt ghi và thử lại." } },
        "zh-CN": { "stringUnit": { "state": "translated", "value": "未生成可用的录制内容。请检查录制设置，然后重试。" } },
        "zh-TW": { "stringUnit": { "state": "translated", "value": "未產生可用的錄製內容。請檢查錄製設定，然後再試一次。" } }
      }
    },
