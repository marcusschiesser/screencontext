    "System Audio permission is unavailable. Enable it in Privacy & Security before recording.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذن صوت النظام غير متاح. فعّله في الخصوصية والأمان قبل التسجيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Berechtigung für Systemaudio ist nicht verfügbar. Vor der Aufnahme unter „Datenschutz & Sicherheit“ aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System Audio permission is unavailable. Enable it in Privacy & Security before recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso de audio del sistema no está disponible. Actívalo en Privacidad y seguridad antes de grabar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation de l’audio système n’est pas disponible. L’activer dans Confidentialité et sécurité avant l’enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorizzazione per l’audio di sistema non è disponibile. Abilitala in Privacy e sicurezza prima di registrare."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "システムオーディオの権限がありません。収録前に「プライバシーとセキュリティ」で有効にしてください。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 오디오 권한을 사용할 수 없습니다. 녹화 전에 개인정보 보호 및 보안에서 활성화하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão de áudio do sistema não está disponível. Ative-a em Privacidade e Segurança antes de gravar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение на системный звук недоступно. Включите его в разделе «Конфиденциальность и безопасность» перед записью."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem sesi izni kullanılamıyor. Kaydetmeden önce Gizlilik ve Güvenlik'te etkinleştirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có quyền Âm thanh hệ thống. Hãy bật trong Quyền riêng tư & Bảo mật trước khi ghi."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "系统音频权限不可用。请在录制前前往“隐私与安全性”启用。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "系統音訊權限無法使用。請在錄製前前往「隱私權與安全性」啟用。"
          }
        }
      }
    },
    "The audio track could not be added to the local recording.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذرت إضافة مسار الصوت إلى التسجيل المحلي."
          }
        },
        "de": {
