    "Camera permission is unavailable. Enable it in Privacy & Security before recording.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذن الكاميرا غير متاح. فعّله في الخصوصية والأمان قبل التسجيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kameraberechtigung ist nicht verfügbar. Vor der Aufnahme unter „Datenschutz & Sicherheit“ aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera permission is unavailable. Enable it in Privacy & Security before recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso de la cámara no está disponible. Actívalo en Privacidad y seguridad antes de grabar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation de la caméra n’est pas disponible. L’activer dans Confidentialité et sécurité avant l’enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorizzazione per la fotocamera non è disponibile. Abilitala in Privacy e sicurezza prima di registrare."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラの権限がありません。収録前に「プライバシーとセキュリティ」で有効にしてください。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 권한을 사용할 수 없습니다. 녹화 전에 개인정보 보호 및 보안에서 활성화하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão da câmera não está disponível. Ative-a em Privacidade e Segurança antes de gravar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение на камеру недоступно. Включите его в разделе «Конфиденциальность и безопасность» перед записью."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera izni kullanılamıyor. Kaydetmeden önce Gizlilik ve Güvenlik'te etkinleştirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có quyền camera. Hãy bật trong Quyền riêng tư & Bảo mật trước khi ghi."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "相机权限不可用。请在录制前前往“隐私与安全性”启用。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "相機權限無法使用。請在錄製前前往「隱私權與安全性」啟用。"
          }
        }
      }
    },
