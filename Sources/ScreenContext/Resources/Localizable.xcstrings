    "Webcam disconnected. The recording is continuing without it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم فصل كاميرا الويب. يستمر التسجيل بدونها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Webcam wurde getrennt. Die Aufnahme wird ohne sie fortgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Webcam disconnected. The recording is continuing without it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara web se desconectó. La grabación continúa sin ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La webcam a été déconnectée. L’enregistrement continue sans elle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La webcam è stata disconnessa. La registrazione continua senza di essa."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "Webカメラが接続解除されました。Webカメラなしで収録を続けます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "웹캠 연결이 해제되었습니다. 웹캠 없이 녹화를 계속합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A webcam foi desconectada. A gravação continuará sem ela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Веб-камера отключена. Запись продолжается без неё."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Web kamerası bağlantısı kesildi. Kayıt onsuz devam ediyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Webcam đã bị ngắt kết nối. Bản ghi vẫn tiếp tục mà không có webcam."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头已断开连接。录制将在没有摄像头的情况下继续。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "網路攝影機已中斷連線。錄製將在沒有網路攝影機的情況下繼續。"
          }
        }
      }
    },
    "Webcam overlay; drag to move or drag its border to resize": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تراكب كاميرا الويب؛ اسحب للنقل أو اسحب الحافة لتغيير الحجم"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Webcam-Überlagerung; zum Verschieben ziehen oder den Rand zum Ändern der Größe ziehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Webcam overlay; drag to move or drag its border to resize"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Superposición de cámara web; arrastra para mover o arrastra el borde para cambiar el tamaño"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Superposition de webcam ; faire glisser pour déplacer ou faire glisser le bord pour redimensionner"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovrapposizione webcam; trascina per spostare o trascina il bordo per ridimensionare"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "Webカメラオーバーレイ。ドラッグで移動、境界線をドラッグしてサイズ変更"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "웹캠 오버레이. 드래그하여 이동하거나 테두리를 드래그하여 크기 조절"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobreposição da webcam; arraste para mover ou arraste a borda para redimensionar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наложение веб-камеры; перетащите для перемещения или границу для изменения размера"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Web kamerası katmanı; taşımak için sürükleyin veya boyutlandırmak için kenarını sürükleyin"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lớp phủ webcam; kéo để di chuyển hoặc kéo viền để đổi kích thước"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头叠加层；拖动以移动，或拖动边框以调整大小"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "網路攝影機疊加層；拖移以移動，或拖移邊框以調整大小"
