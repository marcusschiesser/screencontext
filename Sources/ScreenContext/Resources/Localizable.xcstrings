        "de": { "stringUnit": { "state": "translated", "value": "Vorlage hinzufügen" } },
        "en": { "stringUnit": { "state": "translated", "value": "Add template" } },
        "es": { "stringUnit": { "state": "translated", "value": "Añadir plantilla" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Ajouter un modèle" } },
        "it": { "stringUnit": { "state": "translated", "value": "Aggiungi modello" } },
        "ja-JP": { "stringUnit": { "state": "translated", "value": "テンプレートを追加" } },
        "ko-KR": { "stringUnit": { "state": "translated", "value": "템플릿 추가" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Adicionar modelo" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Добавить шаблон" } },
