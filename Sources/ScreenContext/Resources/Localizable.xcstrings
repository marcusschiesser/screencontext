          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风权限不可用。请在录制前前往“隐私与安全性”启用。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風權限無法使用。請在錄製前前往「隱私權與安全性」啟用。"
          }
        }
